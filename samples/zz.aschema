{
  "$dialect": "a/1",
  "types": {
    "Rarity": { "kind": "enum", "values": ["common", "rare", "epic"] },
    "Vec2": { "kind": "struct", "fields": [
      { "name": "x", "type": "f32" }, { "name": "y", "type": "f32" } ] },
    "Weapon": {
      "kind": "struct",
      "groups": { "Combat": { "doc": "Fighting" }, "Advanced": { "collapsed": true } },
      "fields": [
        { "name": "name", "type": "string", "order": -1 },
        { "name": "damage", "type": "i32", "default": 10, "min": 0, "max": 99, "group": "Combat" },
        { "name": "crit", "type": "f32", "default": 0.05, "min": 0, "max": 1, "step": 0.01, "group": "Combat", "label": "Crit chance" },
        { "name": "crit_mult", "type": "f32", "default": 2, "group": "Combat", "show_if": "crit > 0" },
        { "name": "rarity", "type": "Rarity", "widget": "toggle" },
        { "name": "tint", "type": "rgb", "default": "#c8c8c8" },
        { "name": "offset", "type": "Vec2", "default": { "x": 0.5 }, "widget": "inline", "group": "Advanced" },
        { "name": "id_hash", "type": "u32", "readonly": true, "group": "Advanced" },
        { "name": "notes", "type": "string", "optional": true }
      ]
    },
    "Enemy": { "kind": "struct", "fields": [
      { "name": "weapon", "type": "ref<Weapon>" },
      { "name": "tags", "type": "list<string>" } ] }
  }
}
